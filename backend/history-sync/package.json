{
  "name": "shellf-history-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply shellf-history --local",
    "migrate:remote": "wrangler d1 migrations apply shellf-history --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.0"
  }
}
